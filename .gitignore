lcov.info
coverage/

# Gas snapshots produced ad hoc (the committed one is .gas-snapshot)
*.gas-snapshot.tmp

# Node (api/, sdk/, indexer/ workspaces)
node_modules/
dist/
*.tsbuildinfo

# Editor / OS
.DS_Store
.idea/
.vscode/
