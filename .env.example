# PayRail -- copy to .env and fill in. .env is gitignored; never commit real keys.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Arc public testnet RPC. Take the current URL and chain ID from Circle's Arc
# documentation -- they are intentionally left blank here rather than guessed,
# because deploying against a wrong chain ID silently produces a useless
# deployment (and a replayable signed tx).
ARC_TESTNET_RPC_URL=

# Arc mainnet is not live as of this scaffold. Leave blank.
ARC_MAINNET_RPC_URL=

# Chain ID the deploy script is allowed to broadcast to. Deploy.s.sol reverts
# with ChainIdMismatch if the connected RPC reports anything else, so set this
# to match whichever network --rpc-url targets.
#
# Required on every network except a local dev chain (31337), where leaving it
# blank is tolerated so `--rpc-url local` stays frictionless. Anywhere else,
# blank is itself an error: trusting whatever the RPC happens to be pointed at
# is the mistake this guards against.
EXPECTED_CHAIN_ID=

# ---------------------------------------------------------------------------
# Deployer
# ---------------------------------------------------------------------------
# Prefer a Foundry keystore account over a raw key:
#   cast wallet import payrail-deployer --interactive
#   forge script ... --account payrail-deployer
# Only set PRIVATE_KEY for throwaway testnet keys.
PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Token
# ---------------------------------------------------------------------------
# USDC address on the target Arc network. On Arc, USDC is also the native gas
# token, but these contracts move it as a standard ERC-20, so the token
# contract address is still required.
USDC_ADDRESS=

# Optional: EURC address, for the multi-currency roadmap item.
EURC_ADDRESS=

# ---------------------------------------------------------------------------
# Protocol config
# ---------------------------------------------------------------------------
# Address that receives protocol fees and owns the deployed contracts.
# Use a multisig for anything beyond local testing.
PAYRAIL_TREASURY=

# Address allowed to flag counterparty KYC status in the InvoiceRegistry.
PAYRAIL_COMPLIANCE_OFFICER=

# ---------------------------------------------------------------------------
# Verification (fill once Arc's explorer API is known)
# ---------------------------------------------------------------------------
ARC_EXPLORER_API_KEY=
