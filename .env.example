# PayRail -- copy to .env and fill in. .env is gitignored; never commit real keys.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Arc public testnet. Values below are Arc testnet defaults -- confirm them
# against Circle's current docs before broadcasting, since network parameters
# do change. Providers such as Alchemy and QuickNode also host Arc endpoints if
# you want a dedicated one instead of the public RPC.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Arc mainnet is not live as of this scaffold. Leave blank.
ARC_MAINNET_RPC_URL=

# Chain ID the deploy script is allowed to broadcast to. Deploy.s.sol reverts
# with ChainIdMismatch if the connected RPC reports anything else, so set this
# to match whichever network --rpc-url targets.
#
# 5042002 (0x4CEF52) is Arc testnet. Required on every network except a local
# dev chain (31337), where leaving it blank is tolerated so `--rpc-url local`
# stays frictionless. Anywhere else, blank is itself an error: trusting
# whatever the RPC happens to be pointed at is the mistake this guards against.
EXPECTED_CHAIN_ID=5042002

# ---------------------------------------------------------------------------
# Deployer
# ---------------------------------------------------------------------------
# Prefer a Foundry keystore account over a raw key:
#   cast wallet import payrail-deployer --interactive
#   forge script ... --account payrail-deployer
# Only set PRIVATE_KEY for throwaway testnet keys.
PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Token
# ---------------------------------------------------------------------------
# USDC on Arc testnet. This is a system contract address, not a normally
# deployed token: Arc makes USDC native, which is why it can pay gas.
#
# IMPORTANT -- USDC has two representations on Arc, differing by 1e12:
#   * ERC-20 interface: 6 decimals, at the address below. This is what every
#     PayRail contract reads and transfers.
#   * Native gas token: 18 decimals, used only for gas and msg.value.
# Nothing in src/ is payable or touches msg.value, so the suite stays entirely
# in the 6-decimal view. Do not mix the two when computing amounts off-chain.
#
# Testnet USDC comes from https://faucet.circle.com
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Optional: EURC address, for the multi-currency roadmap item.
EURC_ADDRESS=

# ---------------------------------------------------------------------------
# Protocol config
# ---------------------------------------------------------------------------
# Address that receives protocol fees and owns the deployed contracts.
# Use a multisig for anything beyond local testing.
PAYRAIL_TREASURY=

# Address allowed to flag counterparty KYC status in the InvoiceRegistry.
PAYRAIL_COMPLIANCE_OFFICER=

# ---------------------------------------------------------------------------
# Verification (fill once Arc's explorer API is known)
# ---------------------------------------------------------------------------
ARC_EXPLORER_API_KEY=
